{
  "name": "campusflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CAMPUSFLOW — Smart Fair Queue Management Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:client && npm run build:server",
    "test": "npm run test --workspace=server",
    "test:all": "npm run test:all --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "campusflow",
    "smart-fair-queue",
    "queue-management",
    "saas"
  ],
  "author": "CampusFlow Team",
  "license": "MIT"
}
